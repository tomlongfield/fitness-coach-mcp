# --- openGym ---------------------------------------------------------------
# Base URL of your openGym instance (no trailing slash). Installing openGym
# itself is out of scope for this project — see examples/opengym/ for a
# pointer, and openGym's own docs for the real installation instructions.
OPENGYM_BASE_URL=https://gym.example.com

# Long-lived bearer token for YOUR account, obtained once via the pairing
# flow. From a signed-in browser tab:
#   POST /api/pair/create        -> { code: "K7WQ2MZP" }
# Then, within 5 minutes, from anywhere (curl is fine):
#   POST /api/pair/redeem  { "code": "K7WQ2MZP" }
#   -> { token: "...", user: {...} }
# Put that token here. It's valid for SESSION_DAYS (90 by default on the
# openGym server); with openGym v1.4.0+ this server renews it automatically
# while it's in use and keeps the renewed one in DATA_DIR (see below).
OPENGYM_BEARER_TOKEN=

# --- SparkyFitness -----------------------------------------------------------
# Base URL of your SparkyFitness instance's REST API (no trailing slash,
# include the /api prefix). If this server runs on the same host as
# SparkyFitness, point this at its internal backend port rather than its
# public HTTPS URL — see README for why (same reasoning as OPENGYM_BASE_URL
# above). 3004 is SparkyFitness's own documented default frontend port
# (SPARKY_FITNESS_FRONTEND_PORT in its docker-compose.yml) — check yours if
# you changed it.
SPARKYFITNESS_BASE_URL=http://127.0.0.1:3004/api

# API key for YOUR account. Generate one in the SparkyFitness web UI:
# Settings → Developer & Integrations → API Key Management. Sent as
# `Authorization: Bearer <key>` on every request.
SPARKYFITNESS_API_KEY=

# --- This server -------------------------------------------------------------
# IANA timezone used to resolve "today" for date-scoped tools (get_nutrition_day
# with no date given, get_activity_sessions' lookback window, etc). Defaults
# to UTC if unset — set this to your own zone (e.g. Europe/London) or dates
# near your local midnight can resolve to the wrong day.
TIMEZONE=Europe/London

# Port to listen on (put a reverse proxy with TLS in front of this in prod).
PORT=8787

# Address to listen on. Defaults to 127.0.0.1, for a reverse proxy on the
# same machine. If the proxy reaches this server from elsewhere (another
# container, another host), set HOST=0.0.0.0 and TRUST_PROXY to the proxy's
# address or subnet (it defaults to loopback), so the login lockout still
# sees the real client address.
# HOST=127.0.0.1
# TRUST_PROXY=loopback

# The externally-reachable HTTPS URL this server is served at, e.g.
# https://mcp.example.com/mcp — used to build OAuth metadata URLs and MUST
# exactly match what you type into Claude's "Add custom connector".
PUBLIC_URL=https://mcp.example.com/mcp

# The password Claude's connect flow will ask you for once, in a browser,
# when you first add the connector (and again if you ever disconnect and
# reconnect). Pick something long and random — this is the only thing
# standing between the internet and your health data. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_PASSWORD=

# Random secret used to sign/verify this server's own access tokens.
# Generate with the same command as above.
TOKEN_SECRET=

# --- Optional: where this server keeps its own state ------------------------
# OAuth client registrations (so a restart never needs the Claude connector
# re-added) and the renewed openGym token. Both are credentials: keep the
# directory private and include it in your backups. Default: ./data in the
# install directory.
# DATA_DIR=
