# Trimmed — the essentials for a real deployment. openGym's own .env.example
# has the full set (admin dashboard, invite-only signup, activity log, AI
# coach, etc.): https://github.com/DuarteSantos8/openGym/blob/main/.env.example

# Passkeys are bound to the exact hostname, and browsers require HTTPS for
# them (except localhost). Set these to your real domain once you're behind
# a reverse proxy with TLS — not the defaults below, which only work for
# local testing.
RP_ID=gym.example.com
ORIGIN=https://gym.example.com
RP_NAME=openGym

# The host port `web` publishes on. This is the port that matters for the
# MCP server's OPENGYM_BASE_URL — point your reverse proxy (and, if
# co-located, the MCP server itself) at this port. See the main README's
# "why point at the internal port" note.
WEB_PORT=8080
