# Trimmed — the essentials for the compose file in this directory.
# SparkyFitness's own .env.example has the full set (Garmin, OIDC, email,
# file-based secrets, rate limits, etc.):
# https://github.com/CodeWithCJ/SparkyFitness/blob/main/docker/.env.example

SPARKY_FITNESS_DB_NAME=sparkyfitness_db
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_PASSWORD=change-me
SPARKY_FITNESS_APP_DB_USER=sparky_app
SPARKY_FITNESS_APP_DB_PASSWORD=change-me-too

# Must match wherever the frontend is actually reachable — used for CORS.
# For production, your real HTTPS domain.
SPARKY_FITNESS_FRONTEND_URL=https://tracker.example.com

# Generate both with: openssl rand -base64 32
SPARKY_FITNESS_API_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

# The host port `sparkyfitness-frontend` publishes on. This is the port
# that matters for the MCP server's SPARKYFITNESS_BASE_URL — point your
# reverse proxy (and, if co-located, the MCP server itself) at this port.
# See the main README's "why point at the internal port" note.
SPARKY_FITNESS_FRONTEND_PORT=3004
